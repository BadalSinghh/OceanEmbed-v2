# OceanEmbed Credentials Configuration File
# Copy this file to .env and fill in your credentials:
# cp .env.example .env

# ==============================================================================
# 1. Copernicus Marine Service (CMEMS) Credentials
# Free registration at: https://data.marine.copernicus.eu/register
# Required for:
# - SST (OSTIA 10.48670/moi-00168)
# - SSS (Multi-Obs 10.48670/moi-00051)
# - SLA (DUACS 10.48670/moi-00145)
# - Subsurface Temperature Target (GLORYS12V1 10.48670/moi-00021)
# ==============================================================================
COPERNICUSMARINE_SERVICE_USERNAME=your_copernicus_username_here
COPERNICUSMARINE_SERVICE_PASSWORD=your_copernicus_password_here

# ==============================================================================
# 2. NASA Earthdata Login Credentials
# Free registration at: https://urs.earthdata.nasa.gov/users/new
# Required for:
# - Surface Currents U/V (OSCAR 0.25° Final v2.0)
# - Surface Winds U/V (CCMP 10m v3.1)
# ==============================================================================
EARTHDATA_USERNAME=your_earthdata_username_here
EARTHDATA_PASSWORD=your_earthdata_password_here
